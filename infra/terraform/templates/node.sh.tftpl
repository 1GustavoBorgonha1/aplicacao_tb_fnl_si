#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
STAGE=dependencias
trap 'printf "Falha na inicializacao: etapa=%s linha=%s\n" "$STAGE" "$LINENO" >&2' ERR
# A AMI AL2023 ja inclui AWS CLI v2. O RPM correto e awscli-2.
# Nao registrar tokens no log do cloud-init.
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y awscli-2
fi
dnf install -y jq
%{ if role == "server" ~}
dnf install -y postgresql16
%{ endif ~}
systemctl enable --now amazon-ssm-agent
export AWS_DEFAULT_REGION='${region}'
STAGE=token-k3s
TOKEN=""
for attempt in $(seq 1 60); do
  if TOKEN=$(aws ssm get-parameter --name '${token_parameter}' --with-decryption --query Parameter.Value --output text) && [ -n "$TOKEN" ]; then
    break
  fi
  sleep 10
done
[ -n "$TOKEN" ] || { echo 'Falha ao obter token K3s'; exit 1; }
STAGE=configuracao-k3s
install -d -m 700 /etc/rancher/k3s
cat >/etc/rancher/k3s/config.yaml <<EOF
token: "$TOKEN"
%{ if role == "server" ~}
node-name: '${node_name}'
node-taint:
  - 'node-role.kubernetes.io/control-plane=true:NoSchedule'
disable:
  - traefik
  - servicelb
%{ else ~}
server: 'https://${master_ip}:6443'
# Nova EC2 pode reutilizar IP/hostname de um no removido pelo ASG.
with-node-id: true
node-label:
  - 'workload=application'
%{ endif ~}
EOF
chmod 600 /etc/rancher/k3s/config.yaml
unset TOKEN
STAGE=instalacao-k3s
curl --fail --silent --show-error --location --retry 5 https://get.k3s.io -o /root/install-k3s.sh
INSTALL_K3S_VERSION='${version}' INSTALL_K3S_EXEC='${role}' sh /root/install-k3s.sh
