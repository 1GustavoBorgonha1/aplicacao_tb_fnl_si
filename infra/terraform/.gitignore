# Providers, cache e ferramentas locais
**/.terraform/
.tools/

# Estados e locks de execucao (inclusive bootstrap)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info

# Planos salvos e exportacoes; podem conter segredos
*.tfplan
*.tfplan.*
*.plan
*.plan.*
tfplan
tfplan.*

# Configuracao real; manter exemplos no Git
*.tfvars
*.tfvars.json
backend.hcl
backend.*.hcl
*.tfbackend
*.tfbackend.json
!*.example

# Credenciais e segredos locais
.env
.env.*
!.env.example
.aws/
.kube/
*.pem
*.key
*.p12
*.pfx

# Logs e temporarios
*.log
crash.*.log
*.tmp
*.bak
*~

# Lock dos providers deve ser versionado (principal e bootstrap)
!.terraform.lock.hcl
