# Copie para .env e troque TODOS os valores. O .env nunca deve ser commitado.

# Porta do frontend no host
APP_PORT=8080

# Banco (local: container postgres | AWS: dados do RDS)
POSTGRES_DB=marmifit
POSTGRES_USER=marmifit
POSTGRES_PASSWORD=troque-esta-senha

# Segredo do JWT — mínimo 32 caracteres. Gere com:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres

# Admin inicial (criado no primeiro start). Troque a senha em produção.
ADMIN_EMAIL=admin@marmifit.local
ADMIN_PASSWORD=Admin12345
