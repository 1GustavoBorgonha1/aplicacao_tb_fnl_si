# /opt/marmifit/.env na EC2 PRIVADA (chmod 600). Nunca commitar o arquivo real.
DATABASE_URL=postgres://marmifit:<senha>@<endpoint-rds>.rds.amazonaws.com:5432/marmifit
JWT_SECRET=<openssl rand -base64 48>
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=<senha-forte-trocar-apos-primeiro-login>
S3_BUCKET=marmifit-imagens-<sufixo>
AWS_REGION=us-east-1
# URL pública das imagens (CloudFront na frente do bucket privado)
S3_PUBLIC_URL=https://<id>.cloudfront.net
